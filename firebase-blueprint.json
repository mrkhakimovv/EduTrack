{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account in the system (admin, learning center admin, or teacher)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "center_admin"] },
        "centerId": { "type": "string" },
        "centerCode": { "type": "string" },
        "centerName": { "type": "string" },
        "subject": { "type": "string" },
        "teacherId": { "type": "string" },
        "phone": { "type": "string" },
        "plainPassword": { "type": "string" },
        "isBlocked": { "type": "boolean" },
        "isUnlimited": { "type": "boolean" },
        "appPayments": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "username", "role", "createdAt"]
    },
    "Group": {
      "title": "Group",
      "description": "A group of students with a schedule",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "centerId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "name": { "type": "string" },
        "time": { "type": "string" },
        "days": { "type": "array", "items": { "type": "number" } },
        "monthlyPayment": { "type": "number" },
        "createdAt": { "type": "string" },
        "archived": { "type": "boolean" },
        "archivedAt": { "type": "string" },
        "deletedAt": { "type": "string" },
        "history": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["userId", "name", "time", "days", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "A student in the system",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "centerId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "parentPhone": { "type": "string" },
        "school": { "type": "string" },
        "grade": { "type": "string" },
        "groupIds": { "type": "array", "items": { "type": "string" } },
        "joinDate": { "type": "string" },
        "firstMonthPayment": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "groupPricing": { "type": "object" },
        "createdAt": { "type": "string" },
        "archived": { "type": "boolean" },
        "archivedAt": { "type": "string" },
        "deletedAt": { "type": "string" },
        "history": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["userId", "fullName", "phone", "groupIds", "joinDate", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record for a student",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "centerId": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "editDates": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "studentId", "amount", "month", "date", "note"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance record for a group inside a specific month",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "centerId": { "type": "string" },
        "groupId_month": { "type": "string" },
        "records": { "type": "object" }
      },
      "required": ["userId", "groupId_month", "records"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles including learning center accounts and teachers"
    },
    "groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Groups belonging to a learning center or teacher"
    },
    "students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students belonging to a learning center or teacher"
    },
    "payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payments tracked by a learning center or teacher"
    },
    "attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Attendance per group-month tracked by a learning center or teacher"
    }
  }
}
